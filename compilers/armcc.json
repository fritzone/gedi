{
    "id": "armcc",
    "name": "Arm Compiler 5 (armcc, legacy Keil)",
    "order": 102,
    "description": "The older EDG-based Arm compiler from Keil MDK and RVDS.",
    "setup": "plain",
    "match": {
        "executables": [
            "armcc"
        ],
        "version_args": "--vsn"
    },
    "command": {
        "always": [
            "--cpp"
        ],
        "exe_ext": ".axf",
        "host_libraries": false,
        "standard_flag": "",
        "standard_flags": {
            "c++11": "--cpp11",
            "c++14": "--cpp11",
            "c++17": "--cpp11",
            "c++20": "--cpp11",
            "c++23": "--cpp11",
            "c++26": "--cpp11"
        }
    },
    "diagnostics": {
        "regex": "^\"(.+?)\", line (\\d+)(?:\\.(\\d+))?: ([Cc]atastrophic error|[Ee]rror|[Ww]arning|[Rr]emark)[^:]*: (.*)",
        "file": 1,
        "line": 2,
        "column": 3,
        "severity": 4,
        "message": 5
    },
    "capabilities": {
        "parse_headers": "host",
        "meson": false,
        "runs_on_host": false,
        "debuggable": false
    },
    "top_option": {
        "id": "cpu",
        "default": 0,
        "choices": [
            {
                "label": "default",
                "flag": ""
            },
            {
                "label": "ARM7TDMI",
                "flag": "--cpu=ARM7TDMI"
            },
            {
                "label": "Cortex-M0",
                "flag": "--cpu=Cortex-M0"
            },
            {
                "label": "Cortex-M3",
                "flag": "--cpu=Cortex-M3"
            },
            {
                "label": "Cortex-M4",
                "flag": "--cpu=Cortex-M4"
            },
            {
                "label": "Cortex-M4 with FPU",
                "flag": "--cpu=Cortex-M4.fp"
            },
            {
                "label": "Cortex-M7",
                "flag": "--cpu=Cortex-M7"
            }
        ],
        "label": "Target CPU"
    },
    "options": [
        {
            "tab": "Basic",
            "groups": [
                {
                    "name": "Debugging",
                    "items": [
                        {
                            "id": "debug_symbols",
                            "label": "Debug information",
                            "flag": "-g",
                            "default": true,
                            "role": "debug"
                        }
                    ]
                },
                {
                    "name": "Optimization",
                    "items": [
                        {
                            "id": "optimization",
                            "default": 0,
                            "choices": [
                                {
                                    "label": "-O0",
                                    "flag": "-O0"
                                },
                                {
                                    "label": "-O1",
                                    "flag": "-O1"
                                },
                                {
                                    "label": "-O2",
                                    "flag": "-O2"
                                },
                                {
                                    "label": "-O3",
                                    "flag": "-O3"
                                }
                            ],
                            "role": "optimization"
                        },
                        {
                            "id": "otime",
                            "label": "Optimise for time rather than space",
                            "flag": "-Otime"
                        }
                    ]
                },
                {
                    "name": "C++",
                    "items": [
                        {
                            "id": "exceptions",
                            "label": "Enable exceptions",
                            "flag": "--exceptions"
                        },
                        {
                            "id": "no_rtti",
                            "label": "Disable RTTI",
                            "flag": "--no_rtti"
                        }
                    ]
                }
            ]
        }
    ]
}
