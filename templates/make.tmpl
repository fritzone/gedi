CXX      = g++
CXXFLAGS = {{ make.cxxflags }}
LDFLAGS  = {{ make.ldflags }}

all:{% for target in targets %} {{ target.name }}{% endfor %}

{% for target in targets %}
{{ target.name }}:{% for o in target.objects %} {{ o }}{% endfor %}
	$(CXX) $(CXXFLAGS) -o $@ $^ $(LDFLAGS)

{% for c in target.compiles %}
{{ c.obj }}: {{ c.src }}
	$(CXX) $(CXXFLAGS) -c $<
{% endfor %}
{% endfor %}
clean:
	rm -f{% for target in targets %}{% for o in target.objects %} {{ o }}{% endfor %} {{ target.name }}{% endfor %}

.PHONY: all clean
