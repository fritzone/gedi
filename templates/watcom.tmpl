# {{ project.name }} - Open Watcom makefile generated by gedi.
# gedi rewrites this file when the project's targets, sources or platform change.
#
# Build:  wmake          Clean:  wmake clean
#
# Platform: {{ watcom.platform }}
# SYSTEM, MODEL, the compilers and -bt= select what is built; change the
# platform in Project > Properties rather than here. Every object depends on
# this makefile, so a platform change rebuilds them all.

SYSTEM     = {{ watcom.system }}
MODEL      = {{ watcom.model }}
DLL_SYSTEM = {{ watcom.dll_system }}
CC         = {{ watcom.cc }}
CXX        = {{ watcom.cxx }}
AS         = wasm
CXXFLAGS   = -q -zq -w4 -bt={{ watcom.target }} -m$(MODEL){{ watcom.extra_flags }} {{ watcom.debug }} -od{{ watcom.includes }}
CFLAGS     = $(CXXFLAGS)
ASFLAGS    = -q -m$(MODEL)
LDFLAGS    = option quiet option map {{ watcom.link_debug }}

all :{% for target in targets %} {{ target.wat_file }}{% endfor %} .SYMBOLIC

{% for target in targets %}
{{ target.wat_file }} :{% for o in target.wat_objects %} {{ o }}{% endfor %}{% for l in target.wat_libs %} {{ l }}{% endfor %}
{% if target.wat_is_lib %}
    wlib -q -n -b $^@{% for o in target.wat_objects %} {{ o }}{% endfor %}
{% else %}
    wlink name $^@ system {% if target.wat_is_dll %}$(DLL_SYSTEM){% else %}$(SYSTEM){% endif %} $(LDFLAGS) file { {% for o in target.wat_objects %}{{ o }} {% endfor %}}{% if target.wat_libs %} library { {% for l in target.wat_libs %}{{ l }} {% endfor %}}{% endif %}
{% endif %}

{% for c in target.wat_compiles %}
{{ c.obj }} : {{ c.src }} makefile .AUTODEPEND
    {{ c.cmd }} -fo=$^@ $[@

{% endfor %}
{% endfor %}
clean : .SYMBOLIC
    rm -f *.obj *.err *.map{% for target in targets %} {{ target.wat_file }}{% endfor %}
